# ─────────────────────────────────────────────────────────────────────────────
# YUKTIFI backend environment template
#
# Copy to `.env` and fill in only what you need:
#     cp .env.example .env      (Linux/macOS)
#     copy .env.example .env    (Windows)
#
# EVERY SECRET IS OPTIONAL. With this file copied and left blank the application
# runs fully offline in DEMO_MODE. No feature silently substitutes a fake API key.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ────────────────────────────────────────────────────────────────
# development | production
ENV=development

# Seed the bundled reference tables on first start. Leave true for a fresh clone.
SEED_ON_STARTUP=true

# SQLite path. Relative paths are resolved against backend/, so this is stable no
# matter which directory you launch from. Use :memory: for an ephemeral database.
DATABASE_URL=sqlite:///./yukti.db

# ── Network ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Localhost dev ports by default.
# To accept any origin you must ALSO set ALLOW_WILDCARD_CORS=true and keep
# ENV=development. Wildcard is refused in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_WILDCARD_CORS=false

# ── Demo mode ─────────────────────────────────────────────────────────────
# true  => fully offline. Bundled labelled fixtures only, zero network calls.
#         Every value returned is tagged DEMO DATA / NOT LIVE in the UI.
# false => live providers are used when their API key is present.
DEMO_MODE=false

# Allow outbound network even while DEMO_MODE=true. Leave false to guarantee the
# demo is reproducible with no internet connection.
DEMO_ALLOW_NETWORK=false

# ── Optional AI providers ─────────────────────────────────────────────────
# These power narrative advisory text only. They are never allowed to author a
# number, price, population figure, competitor count or scheme eligibility rule.
# Leave blank to disable; the product does not depend on them.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Optional data providers ───────────────────────────────────────────────
# Government open data / census keys. Blank means that provider is skipped and
# the affected metric is reported UNAVAILABLE rather than filled in.
DATA_GOV_IN_API_KEY=
CENSUS_API_KEY=
OVERPASS_TIMEOUT_SECONDS=7

# ── Security ──────────────────────────────────────────────────────────────
# If set, mutating API routes require header: X-API-Key: <value>. Blank disables
# the guard, which is acceptable only for local single-user use.
API_KEY=

# ── RAG ───────────────────────────────────────────────────────────────────
# Comma-separated absolute directories that document ingestion may read from.
# Blank disables ingestion entirely. Ingestion never accepts an arbitrary
# path from a request body.
#   Linux/macOS: RAG_INGEST_ROOTS=/opt/yukti/documents
#   Windows:     RAG_INGEST_ROOTS=C:\yukti\documents
RAG_INGEST_ROOTS=D:\Ai workshop\Documents SIH 26
