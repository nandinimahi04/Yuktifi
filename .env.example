# ─────────────────────────────────────────────────────────────────────────────
# YUKTIFI workspace environment template (root)
#
# This file covers the variables used outside `backend/`. The backend has its own,
# much fuller template:
#
#     backend/.env.example
#
# Nothing here is a secret, and no value below is a working credential. Copy to
# `.env` only if you need to override something; the application runs with no
# environment file at all.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ───────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend. Requests are made from the browser, so this
# must be reachable from the client, not just from the server.
NEXT_PUBLIC_API_URL=http://localhost:8000,https://yuktifi-backend.onrender.com

NEXT_API_URL=http://localhost:8000,https://yuktifi-backend.onrender.com
# Carto basemap token for the map component. The variable is NEXT_PUBLIC_, so
# whatever is put here is shipped to every visitor in the JavaScript bundle.
# Leave blank to render the map without a basemap; do not commit a real token.
NEXT_PUBLIC_CARTO_ACCESS_TOKEN=

# ── Demo ──────────────────────────────────────────────────────────────────
# Runs the product from bundled, labelled fixtures with outbound network calls
# disabled. The flag is read by the backend (see backend/.env.example for
# DEMO_MODE and DEMO_ALLOW_NETWORK); it is repeated here so it is discoverable
# from the workspace root.
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# Reminder: any file named `.env` is ignored by .gitignore, and `.env` in this
# repository previously contained a live third-party API key. If you add a real
# key anywhere in the tree, treat it as disclosed and rotate it.
# ─────────────────────────────────────────────────────────────────────────────
